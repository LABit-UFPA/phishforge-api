# Template das variaveis de ambiente da phishforge-api.
# Copie para `.env` e preencha. O `.env` e ignorado pelo git; este
# arquivo nao deve conter segredo nenhum.
#
#   cp .env.example .env
#
# Subindo por docker-compose, as variaveis de banco e de Qdrant ja sao
# injetadas pelo proprio compose (apontando para os containers), entao
# na pratica so OPENAI_API_KEY precisa estar no `.env`.

# =========================================
# Obrigatorio
# =========================================

# Chave da OpenAI. Usada na geracao, na normalizacao de prompt, no HyDE,
# na fusao de contexto e nos embeddings. Sem ela nada e gerado.
OPENAI_API_KEY=

# =========================================
# Modelos
# =========================================

MODEL_NAME_LLM=gpt-4o-mini

# ATENCAO: trocar o modelo de embedding muda a dimensionalidade do espaco
# vetorial (text-embedding-3-small = 1536; all-MiniLM-L6-v2 = 384) e
# EXIGE reingerir a base inteira. Nao e uma troca reversivel.
MODEL_NAME_EMBEDDING=all-MiniLM-L6-v2

# =========================================
# Qdrant (base vetorial)
# =========================================

# Local: http://localhost:6333
# Via compose: http://phishforge-qdrant:6333
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=phishing_articles

# =========================================
# Postgres
# =========================================

# Local: localhost. Via compose: phishforge-postgresql.
# DB_PORT e sempre a porta DE DENTRO do container (5432), mesmo que o
# mapeamento externo mude — o compose nao publica essa porta no host,
# para nao conflitar com o stack do phishing-quest-api.
DB_HOST=localhost
DB_PORT=5432
DB_USER=phishforge
DB_PASSWORD=phishforge
DB_NAME=phishforge

# =========================================
# Ingestao / RAG
# =========================================

CHUNK_SIZE=1024
CHUNK_OVERLAP=256
TOP_K_DOCUMENTS=4

# =========================================
# Ainda nao implementadas (chegam com o restante da issue #7)
# =========================================
# Listadas aqui so para registro. O codigo ainda NAO le estas variaveis,
# entao defini-las hoje nao tem efeito.
#
# API_KEY=                 # autenticacao entre servicos (header X-API-Key)
# CORS_ALLOWED_ORIGINS=    # lista de origens permitidas, no lugar de "*"
