# Template das variaveis de ambiente da phishforge-api.
# Copie para `.env` e preencha. O `.env` e ignorado pelo git; este
# arquivo nao deve conter segredo nenhum.
#
#   cp .env.example .env
#
# Subindo por docker-compose, as variaveis de banco e de Qdrant ja sao
# injetadas pelo proprio compose (apontando para os containers), entao
# na pratica so OPENAI_API_KEY e API_KEY precisam estar no `.env`.

# =========================================
# Obrigatorio
# =========================================

# Chave da OpenAI. Usada na geracao, na normalizacao de prompt, no HyDE,
# na fusao de contexto e nos embeddings. Sem ela nada e gerado.
OPENAI_API_KEY=

# Modulo de avaliacao por especialistas (issue #36). Nenhuma das duas
# chaves tem default: vazias, o modulo responde 503 (fail-closed).
# Segredo HS256 dos JWTs de sessao do especialista (`openssl rand -hex 32`).
EXPERT_JWT_SECRET=
EXPERT_JWT_EXPIRES_HOURS=12
# X-API-Key do pesquisador (console de gestao). DISTINTA de API_KEY
# (que autentica o backend Go): nao reutilize o mesmo valor.
RESEARCHER_API_KEY=
# Origem publica do frontend, usada para montar o link de acesso do
# especialista (`{EXPERT_FRONTEND_URL}/avaliacao/entrar?codigo=...`).
EXPERT_FRONTEND_URL=http://localhost:5173

# Itens exigidos para abrir uma rodada (10 faceis + 10 medios + 10 dificeis).
# Rodada piloto menor: reduza aqui.
RODADA_ITENS_ESPERADOS=30

# Autenticacao entre servicos (issue #7): exigida via header
# X-API-Key em TODA rota /api/v1 (geracao, avaliacao e leitura). O
# unico cliente legitimo hoje e o backend Go, chamando servidor-a-
# servidor. Vazia = toda rota responde 503 (falha fechado, nao abre a
# API sem querer). Gere um valor aleatorio longo, ex.:
# `openssl rand -hex 32`.
API_KEY=

# =========================================
# Modelos
# =========================================

MODEL_NAME_LLM=gpt-4o-mini

# ATENCAO: trocar o modelo de embedding muda a dimensionalidade do espaco
# vetorial (text-embedding-3-small = 1536; all-MiniLM-L6-v2 = 384) e
# EXIGE reingerir a base inteira. Nao e uma troca reversivel.
MODEL_NAME_EMBEDDING=all-MiniLM-L6-v2

# =========================================
# Qdrant (base vetorial)
# =========================================

# Local: http://localhost:6333
# Via compose: http://phishforge-qdrant:6333
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=phishing_articles

# =========================================
# Postgres
# =========================================

# Local: localhost. Via compose: phishforge-postgresql.
# DB_PORT e sempre a porta DE DENTRO do container (5432), mesmo que o
# mapeamento externo mude — o compose nao publica essa porta no host,
# para nao conflitar com o stack do phishing-quest-api.
DB_HOST=localhost
DB_PORT=5432
DB_USER=phishforge
DB_PASSWORD=phishforge
DB_NAME=phishforge

# =========================================
# Ingestao / RAG
# =========================================

CHUNK_SIZE=1024
CHUNK_OVERLAP=256
TOP_K_DOCUMENTS=4

# =========================================
# Seguranca / rede (issue #7)
# =========================================

# Lista de origens separadas por virgula, para o navegador poder
# chamar a API diretamente (ex.: um frontend de curadoria). Vazio
# (default) = nenhum middleware de CORS e registrado -- correto para
# uso servidor-a-servidor (o caso do backend Go), que nao precisa de
# CORS nenhum.
# CORS_ALLOWED_ORIGINS=https://curadoria.exemplo.com

# Limite de requisicoes por IP nos endpoints de geracao. Sintaxe da
# lib `limits`: "<numero>/<unidade>" (segundo, minute, hour, day).
GENERATION_RATE_LIMIT=20/minute
